{
  "name": "tuti-qr-reader",
  "main": "expo-router/entry",
  "version": "1.0.11",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "NODE_ENV=development APP_VARIANT=development expo run:android",
    "android-prod": "NODE_ENV=production APP_VARIANT=production expo run:android",
    "build:android": "cd android && ./gradlew assembleRelease && ..",
    "build:android-dev": "cd android && NODE_ENV=development ./gradlew assembleRelease && ..",
    "ios": "NODE_ENV=development APP_VARIANT=development expo run:ios",
    "ios-device": "NODE_ENV=development APP_VARIANT=development expo run:ios --device",
    "ios-prod": "NODE_ENV=prouction APP_VARIANT=production expo run:ios",
    "web": "expo start --web",
    "prepare": "husky",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "bump-patch": "npm version patch --no-git-tag-version && fastlane bump",
    "bump-minor": "npm version minor --no-git-tag-version && fastlane bump",
    "bump-major": "npm version major --no-git-tag-version && fastlane bump",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-firebase/app": "~23.7.0",
    "@react-native-firebase/crashlytics": "~23.7.0",
    "@react-native-picker/picker": "^2.11.1",
    "@react-navigation/native": "^7.1.17",
    "@reduxjs/toolkit": "^2.9.2",
    "@shopify/react-native-skia": "^2.4.14",
    "axios": "^1.13.1",
    "date-fns": "^4.1.0",
    "expo": "~54.0.9",
    "expo-camera": "~17.0.8",
    "expo-constants": "~18.0.9",
    "expo-dev-client": "~6.0.12",
    "expo-font": "~14.0.8",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.7",
    "expo-secure-store": "^15.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-web-browser": "~15.0.7",
    "i18next": "^25.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^16.0.0",
    "react-native": "0.81.4",
    "react-native-country-codes-picker": "^2.3.5",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.13.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-worklets": "0.5.1",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-babel-module": "^5.3.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "patch-package": "^8.0.1",
    "prettier": "^3.6.2",
    "react-native-svg-transformer": "^1.5.1",
    "typescript": "~5.9.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "private": true
}
